layout {

    focus-ring {
        active-color   "#6796e4"
        inactive-color "#161d27"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#6796e4"
        inactive-color "#161d27"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#6796e4"
        inactive-color "#143e85"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#6796e480"
    }
}

recent-windows {
    highlight {
        active-color "#6796e4"
        urgent-color "#fd4663"
    }
}
