# Secrets — never commit these
.zshrc_secrets
.zshrc.local
gh/
hosts.yml

# Logs, sockets and runtime state
*.log
*.sock
*.pid
session.json
.plugins.lock

# Installer-generated desktop entries. These hardcode absolute /opt paths that
# will not exist on another machine, so they are output, not configuration.
config/.local/share/applications/claude-code-url-handler.desktop

# Backups made by editors, installers and me
*.bak
*.bak-*
*.bak.*
*.backup*
*.pre-*
*~

# Scratch files from scripts
*.tmp

# Caches
__pycache__/
.cache/

# Generated by Noctalia's tmux template. Only present when stow folds
# ~/.config/tmux into the repo (fresh machine, directory did not exist yet).
# Just this one file — themes/custom.conf next to it is hand-written and tracked.
config/.config/tmux/themes/noctalia.conf
